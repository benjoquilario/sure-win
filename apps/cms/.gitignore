# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The templates are that opt-in. They name what has to be set and hold no
# secrets, which is the whole point: a variable nobody knows about is a
# variable nobody sets.
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
