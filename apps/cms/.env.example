# Appwrite project (public - shipped to the browser)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://<region>.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_PROJECT_NAME=Social Work Reviewer
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. The API key bypasses table permissions; never expose it.
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=social_work_reviewer
APPWRITE_ASSETS_BUCKET_ID=reviewer_assets
APPWRITE_SESSION_COOKIE=cms-reviewer-session

# Break-glass dashboard access by email, before any user_roles row exists.
APPWRITE_CMS_SUPER_ADMIN_EMAILS=
APPWRITE_CMS_ADMIN_EMAILS=
APPWRITE_CMS_MODERATOR_EMAILS=
APPWRITE_CMS_ENCODER_EMAILS=

# Google Play billing: see .env.billing.example
