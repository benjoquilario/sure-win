# Google Play billing — server-side only.
#
# None of these belong anywhere near the mobile app. If a credential would let
# a client mark itself premium, it is in the wrong place.
#
# Copy the ones you have into .env. Until all three are set:
#   - /api/billing/verify answers 503
#   - /api/billing/notifications answers 503 and refuses every message
#
# Check what is missing with:  pnpm appwrite:billing:check

# The service account JSON downloaded from Google Cloud → IAM → Service Accounts.
#
# Either the raw JSON on one line, or base64 of it — base64 is safer, because a
# private key is mostly newlines and plenty of hosts mangle those.
#   base64 -w0 service-account.json
#
# This is a bearer credential for your revenue. It is never committed, never
# shipped, and never logged.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# The app's package name. Permanent once published.
# Notifications naming a different package are ignored.
GOOGLE_PLAY_PACKAGE_NAME=com.surewin.mobile

# A random secret you invent, shared with the Pub/Sub push subscription.
#
# Pub/Sub cannot send an Appwrite session, so the endpoint is authenticated with
# this instead. Put it in the push endpoint URL:
#
#   https://your-cms.example.com/api/billing/notifications?token=THIS_VALUE
#
# Generate one with:  openssl rand -hex 32
GOOGLE_PLAY_PUBSUB_TOKEN=

# --- Optional: the mock verification endpoint -------------------------------
#
# Turns on POST /api/billing/verify/sandbox, which checks the JWT for real and
# then returns whichever documented response the caller asks for. It talks to
# nothing, writes nothing, and cannot grant access — but leave it off in
# production anyway, so nobody has to reason about whether that is true.
#
# Lets the app build the checkout flow before Play products exist.
BILLING_SANDBOX_ENABLED=
